# Required public HTTPS origin and exact hostname.
TRANS_SITE_ADDRESS=trans.example.com
TRANS_PUBLIC_ORIGIN=https://trans.example.com
TRANS_TRUSTED_HOSTS=["trans.example.com"]
TRANS_ADMIN_USERNAME=admin

# Optional host port overrides. Keep 80/443 for automatic public TLS.
TRANS_HTTP_PORT=80
TRANS_HTTPS_PORT=443

# Same-origin production routing should not need CORS.
TRANS_CORS_ORIGINS=[]

# Trust proxy headers only from Caddy's container network. Narrow this to the actual
# Compose subnet in a hardened installation; 127.0.0.1 is a safe placeholder only.
TRANS_FORWARDED_ALLOW_IPS=127.0.0.1

# Absolute host paths to pre-created secret files. Do not store secret values here.
# Create the bootstrap password as text, for example:
#   umask 077; openssl rand -base64 32 > /etc/trans/admin-bootstrap-password
# The crypto service's planned master-key contract is exact raw 32 bytes:
#   umask 077; openssl rand 32 > /etc/trans/master-key
TRANS_ADMIN_BOOTSTRAP_PASSWORD_SECRET_FILE=/etc/trans/admin-bootstrap-password
TRANS_MASTER_KEY_SECRET_FILE=/etc/trans/master-key
