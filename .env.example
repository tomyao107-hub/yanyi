# Windows/local development server
TRANS_ENVIRONMENT=development
TRANS_HOST=127.0.0.1
TRANS_PORT=8000
TRANS_DATABASE_URL=sqlite:///./data/trans.db
TRANS_UPLOAD_DIR=./data/uploads
TRANS_EXPORT_DIR=./exports
TRANS_FRONTEND_DIST=./frontend/dist
TRANS_RUN_MIGRATIONS_ON_STARTUP=true
TRANS_TRUSTED_HOSTS=["127.0.0.1","localhost","testserver"]
TRANS_CORS_ORIGINS=["http://127.0.0.1:5173","http://localhost:5173"]

# Translation defaults
TRANS_DEFAULT_MODEL=deepseek/deepseek-v4-flash
TRANS_DEFAULT_TEMPERATURE=0.3
TRANS_DEFAULT_MAX_CONCURRENCY=4
TRANS_CONTEXT_TOKEN_BUDGET=1200
TRANS_SEGMENT_MAX_CHARS=1500

# Add only the provider keys that you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
